# OpenAI. The model must support
# response_format: { type: 'json_schema', strict: true }.
# Take a current ID from platform.openai.com/docs/models — IDs are retired
# every few months and a stale one fails as a 404 on every refund.
OPENAI_API_KEY=""
OPENAI_MODEL=""